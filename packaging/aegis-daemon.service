# Aegis real-time protection daemon (Milestone 2).
# `aegis daemon` signals readiness via sd_notify (Type=notify).
[Unit]
Description=Aegis real-time protection daemon
Documentation=https://github.com/raio/aegis
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/aegis daemon
Restart=on-failure
RestartSec=3
RuntimeDirectory=aegis
StateDirectory=aegis

# --- Least-privilege hardening (systemd sandbox) ---
# The daemon needs to read files across the system to scan them, but nothing
# more. These directives drop every capability it does not require.
DynamicUser=no
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aegis
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
# Default (inotify) real-time needs only read access. For the fanotify backend
# (built with --features fanotify) add CAP_SYS_ADMIN here and drop
# MemoryDenyWriteExecute/@mount restrictions, since fanotify uses privileged
# syscalls. inotify is the safe default and requires no extra capability.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
