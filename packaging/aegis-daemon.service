# Aegis real-time protection daemon.
# The daemon itself is delivered in Milestone 2; this hardened unit ships now so
# packaging and the security profile are reviewable up front.
[Unit]
Description=Aegis real-time protection daemon
Documentation=https://github.com/raio/aegis
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/aegis daemon
Restart=on-failure
RestartSec=3

# --- Least-privilege hardening (systemd sandbox) ---
# The daemon needs to read files across the system to scan them, but nothing
# more. These directives drop every capability it does not require.
DynamicUser=no
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aegis
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
# fanotify (real-time) needs CAP_SYS_ADMIN; granted narrowly in M2.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
